# העתק קובץ זה ל-.env והכנס את הפרטים האמיתיים. .env אינו נכנס לגיט.

API_KEY=YOUR_API_KEY_HERE

# כתובת ממשק SIRI.
#
# אזהרה: כתובת שגויה כאן נראית בדיוק כמו תקלת רשת — הכשל הוא ConnectionError,
# requests מנסה שוב שלוש פעמים, והתוצאה היא 502 אחרי כמה שניות בלי שום רמז
# שהשם פשוט לא קיים. זה כבר קרה: הערך היה api.mot.gov.il, שאינו קיים ב-DNS,
# ו-/arrivals החזיר 502 בעקביות.
#
# לבדיקה: GET /health מדווח siriReachable ו-siriReason.
SIRI_BASE_URL=https://moran.mot.gov.il/Channels/HTTPChannel/SmQuery/2.8

ALERTS_URL=https://gtfs.mot.gov.il/ServiceAlerts/gtfs_rt_alerts.pb

PORT=5000
# בייצור Caddy מאזין לחוץ, ולכן השרת נשאר מקומי.
HOST=127.0.0.1

# שרשרת התעודות של moran. **נדרש** — moran אינו שולח את תעודת הביניים שחתמה
# עליו, ולכן האימות נכשל ב-"unable to get local issuer certificate".
# להפקה:  bash scripts/fetch-siri-ca.sh
# זו החלופה לכיבוי אימות TLS, שהיה כאן וחשף את המפתח. ראה deploy/README.md.
SIRI_CA_BUNDLE=

# DEBUG / INFO / WARNING
LOG_LEVEL=INFO
