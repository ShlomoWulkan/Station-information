[Unit]
Description=Midaa Tachana API (Flask/gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=midaa
Group=midaa
WorkingDirectory=/opt/midaa-tachana/server
EnvironmentFile=/opt/midaa-tachana/server/.env

# worker אחד ו-threads, לא כמה workers: כל worker הוא תהליך נפרד עם עותק משלו
# של ~35 אלף תחנות ושל ה-cache. יותר מאחד מכפיל זיכרון ומפצל את ה-cache.
ExecStart=/opt/midaa-tachana/server/venv/bin/gunicorn \
    --workers 1 \
    --threads 8 \
    --bind 127.0.0.1:5000 \
    --timeout 180 \
    --access-logfile - \
    --error-logfile - \
    wsgi:app

# ה-GTFS (140MB) נטען בעלייה, ולכן ההמתנה הארוכה לפני שה-unit נחשב כשל.
TimeoutStartSec=300

# הכרח ולא נוחות: משרד התחבורה מאשר קריאות מ-IP הזה בלבד, ולכן אין מכונת
# גיבוי ואי אפשר להריץ עוד אחת. אם התהליך נופל, אין מי שיחליף אותו.
Restart=always
RestartSec=5

# הידוק בסיסי — לשרת אין צורך בכתיבה לדיסק ולא בהרשאות מיוחדות.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/midaa-tachana/server

[Install]
WantedBy=multi-user.target
