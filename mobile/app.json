{
  "expo": {
    "name": "מידע תחנה",
    "slug": "midaa-tachana",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "midaatachana",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "האפליקציה צריכה גישה למיקום כדי למצוא תחנות קרובות"
        }
      ]
    ],
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000d28"
      },
      "package": "com.midaatachana.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC7jM2kIHMCLMnI-UrEx2LUJI49q34sfdY"
        }
      }
    },
    "ios": {
      "bundleIdentifier": "com.midaatachana.app"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d1a271b1-1613-4397-b866-f36d4b506a49"
      }
    }
  }
}
