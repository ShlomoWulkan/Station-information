# העתק ל-mobile/.env והכנס ערכים אמיתיים. mobile/.env אינו נכנס לגיט.

# כתובת הבסיס של השרת. בבילד production חייבת להיות https://
# ראה server/deploy/README.md
EXPO_PUBLIC_API_URL=http://204.168.150.129:5000

# מפתח Google Maps ל-Android, מוגבל ל-package + SHA-1.
# ראה docs/SECRETS.md — במיוחד את מגבלת המכסה היומית.
GOOGLE_MAPS_API_KEY_ANDROID=

# 'development' פותח HTTP גלוי באנדרואיד ו-iOS. אין להגדיר בבילד production.
APP_VARIANT=development
